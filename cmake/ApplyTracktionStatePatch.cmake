# Aizana fixes for reproducible Undo/layout/lifecycle failures. Preserve local edits.
find_package(Git REQUIRED)
set(_te "${CMAKE_CURRENT_LIST_DIR}/../extern/tracktion_engine")
set(_patch "${CMAKE_CURRENT_LIST_DIR}/../patches/tracktion-state-lifecycle.patch")
set(_original 0)
set(_patched 0)
if(NOT EXISTS "${_te}/modules/tracktion_engine/model/edit/tracktion_Edit.cpp")
    message(FATAL_ERROR "Tracktion sources missing. Run git submodule update --init extern/JUCE extern/tracktion_engine")
endif()
file(SHA256 "${_te}/modules/tracktion_engine/plugins/external/tracktion_ExternalPlugin.cpp" _hash)
if(_hash STREQUAL "38cf0d9a898b02cbcd46bde02b4830f63004f0d28ec020702bc4bfcf44a97f29")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "5a083a0da9d97bb43fa8aaa5de350144c66ec1ffeb48149d15b63475e7a3fd6d")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised Tracktion source: modules/tracktion_engine/plugins/external/tracktion_ExternalPlugin.cpp; preserve local changes and review state/lifecycle patch")
endif()
file(SHA256 "${_te}/modules/tracktion_engine/model/edit/tracktion_Edit.cpp" _hash)
if(_hash STREQUAL "4329875765f86f2b4000ed0019ab393d915f69c8672e68614698fdd3b033718a")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "79b7c4daa918c5559df426e5ae7bfdcb53ccc4a6ad8ec9ff1e9a0a0e898529ae")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised Tracktion source: modules/tracktion_engine/model/edit/tracktion_Edit.cpp; preserve local changes and review state/lifecycle patch")
endif()
file(SHA256 "${_te}/modules/tracktion_engine/model/clips/tracktion_ClipOwner.cpp" _hash)
if(_hash STREQUAL "d93cd1a5af47dc5d58552acc15ccf8bf3aa70588c0194fff200538858231e7b2")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "4115fe1c7314825a5f601c0926c0f05c1bada431414d69070dfaa9a6ada52e70")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised Tracktion source: modules/tracktion_engine/model/clips/tracktion_ClipOwner.cpp; preserve local changes and review state/lifecycle patch")
endif()
if(_original EQUAL 3)
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "${_patch}"
        WORKING_DIRECTORY "${_te}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "State/lifecycle patch check failed: ${_error}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${_patch}"
        WORKING_DIRECTORY "${_te}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "State/lifecycle patch failed: ${_error}")
    endif()
    message(STATUS "Tracktion state/lifecycle patch applied")
elseif(_patched EQUAL 3)
    message(STATUS "Tracktion state/lifecycle patch already present")
else()
    message(FATAL_ERROR "Mixed patched/unpatched Tracktion files; refusing to overwrite changes")
endif()

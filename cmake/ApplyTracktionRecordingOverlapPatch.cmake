find_package(Git REQUIRED)
set(_te "${CMAKE_CURRENT_LIST_DIR}/../extern/tracktion_engine")
set(_patch "${CMAKE_CURRENT_LIST_DIR}/../patches/tracktion-recording-overlap.patch")
set(_original 0)
set(_patched 0)
file(SHA256 "${_te}/modules/tracktion_engine/utilities/tracktion_EngineBehaviour.h" _hash)
if(_hash STREQUAL "f6add117ecff4d79b71bde58ada87771478950a155ca9cf9de2ec3117e3a914f")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "df1ba98bb864e29b0f13faf55434ab2e6b1a6e13af9a6c940d21a85048ccb109")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised overlap source: modules/tracktion_engine/utilities/tracktion_EngineBehaviour.h; preserve local edits")
endif()
file(SHA256 "${_te}/modules/tracktion_engine/playback/graph/tracktion_EditNodeBuilder.cpp" _hash)
if(_hash STREQUAL "4a55f6be2a8fc38d10d2529fa4ba6a4663d8b818b55b128e87340d7b9337ce5c")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "cd483c3e7eb9311b6eee6729a4e6684504d7012217a657e42580391a44a1366f")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised overlap source: modules/tracktion_engine/playback/graph/tracktion_EditNodeBuilder.cpp; preserve local edits")
endif()
file(SHA256 "${_te}/modules/tracktion_engine/model/clips/tracktion_Clip.cpp" _hash)
if(_hash STREQUAL "85e2f637c269c1ed99b1f84aca5c5648a537d2b4d3675152e3b6b2d23ce8dc3a")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "cb13f7f5bba3efa2832a7d86ada32dc1360ccfd605ed2bbe3d598655e6442aa1")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised overlap source: modules/tracktion_engine/model/clips/tracktion_Clip.cpp; preserve local edits")
endif()
if(_original EQUAL 3)
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${_patch}" WORKING_DIRECTORY "${_te}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Recording overlap patch failed: ${_error}")
    endif()
elseif(NOT _patched EQUAL 3)
    message(FATAL_ERROR "Mixed recording overlap patch state; preserve local edits")
endif()

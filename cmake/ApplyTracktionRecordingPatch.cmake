# Reproduce the reviewed recording fix without silently overwriting local edits.
find_package(Git REQUIRED)
set(_te "${CMAKE_CURRENT_LIST_DIR}/../extern/tracktion_engine")
set(_patch "${CMAKE_CURRENT_LIST_DIR}/../patches/tracktion-recording-errors.patch")
set(_original 0)
set(_patched 0)
if(NOT EXISTS "${_te}/modules/tracktion_engine/playback/tracktion_EditPlaybackContext.cpp")
    message(FATAL_ERROR "Tracktion sources missing. Run git submodule update --init extern/JUCE extern/tracktion_engine")
endif()
file(SHA256 "${_te}/modules/tracktion_engine/playback/tracktion_EditPlaybackContext.cpp" _hash)
if(_hash STREQUAL "8d462ef23495ac1b40b407320653097895daef488c8c7be328556ede3210e6f7")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "0f2b95536777c71bc5eba4ff0583dd7a8b206eda6984b541538c7977caa60cd9")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised Tracktion recording source: modules/tracktion_engine/playback/tracktion_EditPlaybackContext.cpp. Preserve local edits and review the patch against the new engine version.")
endif()
if(NOT EXISTS "${_te}/modules/tracktion_engine/playback/tracktion_EditPlaybackContext.h")
    message(FATAL_ERROR "Tracktion sources missing. Run git submodule update --init extern/JUCE extern/tracktion_engine")
endif()
file(SHA256 "${_te}/modules/tracktion_engine/playback/tracktion_EditPlaybackContext.h" _hash)
if(_hash STREQUAL "a4cab681a53755032378426448c5d73afff659d5105aae1612ee8c7adfadb771")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "bf2ace88dba615b7f6067234168121ea16c30e386faf90fb71f5c7ea46294300")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised Tracktion recording source: modules/tracktion_engine/playback/tracktion_EditPlaybackContext.h. Preserve local edits and review the patch against the new engine version.")
endif()
if(NOT EXISTS "${_te}/modules/tracktion_engine/playback/tracktion_TransportControl.cpp")
    message(FATAL_ERROR "Tracktion sources missing. Run git submodule update --init extern/JUCE extern/tracktion_engine")
endif()
file(SHA256 "${_te}/modules/tracktion_engine/playback/tracktion_TransportControl.cpp" _hash)
if(_hash STREQUAL "2ca55395cc3905b37abdaefb28b52c3a92084cc6d446d185ace307fec15b90d6")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "d69548a6420410af56133a709e15cb83544153e3b4dffad0e2c3acb83be908ae")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised Tracktion recording source: modules/tracktion_engine/playback/tracktion_TransportControl.cpp. Preserve local edits and review the patch against the new engine version.")
endif()
if(NOT EXISTS "${_te}/modules/tracktion_engine/playback/devices/tracktion_WaveInputDevice.cpp")
    message(FATAL_ERROR "Tracktion sources missing. Run git submodule update --init extern/JUCE extern/tracktion_engine")
endif()
file(SHA256 "${_te}/modules/tracktion_engine/playback/devices/tracktion_WaveInputDevice.cpp" _hash)
if(_hash STREQUAL "6dd21a1e3fe4589c4d0f72c24ae6633d6d6fa69952d3b6246fcd9afdd7e95fe6")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "2394236d43457019764a494dae30b83d16c2c9a2834e6642839812d2477d1ab9" OR _hash STREQUAL "087975486d87358f154a77a2c2a9f383fa9ebed9d92201d73074d6bdb0577dd4")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised Tracktion recording source: modules/tracktion_engine/playback/devices/tracktion_WaveInputDevice.cpp. Preserve local edits and review the patch against the new engine version.")
endif()
if(_original EQUAL 4)
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "${_patch}"
                    WORKING_DIRECTORY "${_te}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Recording patch check failed: ${_error}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${_patch}"
                    WORKING_DIRECTORY "${_te}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Recording patch failed: ${_error}")
    endif()
    message(STATUS "Tracktion recording error patch applied")
elseif(_patched EQUAL 4)
    message(STATUS "Tracktion recording error patch already present")
else()
    message(FATAL_ERROR "Mixed patched/unpatched Tracktion files; refusing to overwrite local changes")
endif()

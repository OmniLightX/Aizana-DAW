# Preserve local dependency edits while applying the reviewed render-job fix.
find_package(Git REQUIRED)
set(_te "${CMAKE_CURRENT_LIST_DIR}/../extern/tracktion_engine")
set(_patch "${CMAKE_CURRENT_LIST_DIR}/../patches/tracktion-render-job-lifetime.patch")
set(_original 0)
set(_patched 0)
if(NOT EXISTS "${_te}/modules/tracktion_engine/model/export/tracktion_RenderManager.cpp")
    message(FATAL_ERROR "Tracktion sources missing. Run git submodule update --init extern/JUCE extern/tracktion_engine")
endif()
file(SHA256 "${_te}/modules/tracktion_engine/model/export/tracktion_RenderManager.cpp" _hash)
if(_hash STREQUAL "6fb26a037ac844c4b7fed494b086fdd7015b6ae9b27e315a7281a38f4e2a0675")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "304740ace509afd7310f9ed040016afebb9263a9348e0e8607998a01d4e1c738")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised Tracktion source: modules/tracktion_engine/model/export/tracktion_RenderManager.cpp; preserve local changes and review render-job patch")
endif()
if(NOT EXISTS "${_te}/modules/tracktion_engine/utilities/tracktion_BackgroundJobs.h")
    message(FATAL_ERROR "Tracktion sources missing. Run git submodule update --init extern/JUCE extern/tracktion_engine")
endif()
file(SHA256 "${_te}/modules/tracktion_engine/utilities/tracktion_BackgroundJobs.h" _hash)
if(_hash STREQUAL "ebdd5df93783e87d3947f8e5c2db77353e71610070d26d9c7edb38bf633cdc0f")
    math(EXPR _original "${_original} + 1")
elseif(_hash STREQUAL "783f45670b1224afcfd605abc133c66b18f5eeb3e416bd6cc0aec771fa9c0382")
    math(EXPR _patched "${_patched} + 1")
else()
    message(FATAL_ERROR "Unrecognised Tracktion source: modules/tracktion_engine/utilities/tracktion_BackgroundJobs.h; preserve local changes and review render-job patch")
endif()
if(_original EQUAL 2)
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "${_patch}"
        WORKING_DIRECTORY "${_te}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Render-job patch check failed: ${_error}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${_patch}"
        WORKING_DIRECTORY "${_te}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Render-job patch failed: ${_error}")
    endif()
    message(STATUS "Tracktion render-job lifetime patch applied")
elseif(_patched EQUAL 2)
    message(STATUS "Tracktion render-job lifetime patch already present")
else()
    message(FATAL_ERROR "Mixed patched/unpatched Tracktion files; refusing to overwrite changes")
endif()
